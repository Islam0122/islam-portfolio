# Production origin, e.g. https://your-domain.example (enables canonical + sitemap)
VITE_SITE_URL=

# YouTube video ID of the OkurmenKIDS showcase (OKURMENKIDS_YOUTUBE_VIDEO_ID), e.g. the "xxxxxxxxxxx" in
# https://www.youtube.com/watch?v=xxxxxxxxxxx. Leave empty until the video is uploaded: the site then shows a placeholder.
VITE_OKURMENKIDS_YOUTUBE_VIDEO_ID=
